# sp-frontend 개발 환경값. 비밀 값이 아니다 — 세 서비스의 로컬 주소다.
# 정본: sp-docs/api-contract.md §1 경로 규칙
VITE_AUTH_BASE_URL=http://localhost:8083
VITE_MEMBER_BASE_URL=http://localhost:8081
VITE_BOARD_BASE_URL=http://localhost:8082

# direct = 브라우저가 세 주소를 직접 호출한다 (CORS preflight 가 실제로 검증된다)
# proxy  = Vite dev 프록시를 경유한다 (같은 오리진. CORS 를 우회하는 비상구)
VITE_API_MODE=direct
